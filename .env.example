# PayPal sandbox app credentials: developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
PORT=8787
# OpenAI API key for the contract drafter, verifier and settlement proposer: platform.openai.com → API keys
OPENAI_API_KEY=
# Optional: any OpenAI model with vision, tools and structured outputs (default gpt-5-nano-2025-08-07)
OPENAI_MODEL=
